@model SlipzyD2.ViewModels.RegisterViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slipzy - Sign Up</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/signup.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="@Url.Action("Index", "Home")" style="color: #163628;">
                <img src="/assets/bunny.png" width="32" height="32" alt="Logo"> Slipzy
            </a>
            <div class="ms-auto d-flex gap-4 fs-7 fw-semibold">
                <a href="@Url.Action("Index", "Home")" class="text-dark text-decoration-none">Home</a>
                <a href="@Url.Action("Index", "Home")#about" class="text-dark text-decoration-none">About</a>
                <a href="@Url.Action("Index", "Home")#features" class="text-dark text-decoration-none">Features</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Left side banner -->
            <div class="col-md-5 left-panel text-center p-4">
                <img src="/assets/bunny.png" width="160" class="mb-3 rounded" alt="Bunny">
                <h2 class="fw-bold mb-3" style="color: #163628;">join Slipzy</h2>
                <p class="small text-dark mb-0" style="max-width: 250px;">
                    create a private account and keep every purchase in one place.
                </p>
            </div>

            <!-- Right side form -->
            <div class="col-md-7 right-panel p-4">
                <div class="auth-card">
                    <h3 class="fw-bold mb-3" style="color: #163628;">create account</h3>
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        <div class="mb-2">
                            <label asp-for="FullName" class="form-label small text-muted mb-1">full name</label>
                            <input asp-for="FullName" class="form-control form-control-custom" placeholder="John Doe">
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Email" class="form-label small text-muted mb-1">email</label>
                            <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="you@example.com">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Password" class="form-label small text-muted mb-1">password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-custom" placeholder="••••••••">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small text-muted mb-1">Confirm password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-custom" placeholder="••••••••">
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <p class="text-muted small mb-3" style="font-size: 0.75rem;">your records are private. only you can see them.</p>
                        <button type="submit" class="btn btn-dark-green mb-3">sign up</button>
                        <div class="text-center small text-muted">
                            already registered? <a href="@Url.Action("Login", "Account")" class="fw-bold text-decoration-none" style="color: #163628;">log in</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
